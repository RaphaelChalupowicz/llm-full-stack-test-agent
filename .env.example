OPENAI_API_KEY=your_api_key_here

# Model configuration
OPENAI_MODEL=gpt-5.4-mini

# LLM behavior tuning
OPENAI_MAX_TOKENS_CLASSIFY=120
OPENAI_MAX_TOKENS_GENERATE=2600
OPENAI_MAX_TOKENS_REPAIR=3200
OPENAI_TEMPERATURE_GENERATE=0.1
OPENAI_TEMPERATURE_REPAIR=0

# Agent runtime defaults
DEFAULT_COVERAGE_PATH=coverage/coverage-summary.json
DEFAULT_MAX_FILES=2
MAX_FIX_ATTEMPTS=3
TEST_TIMEOUT_SECONDS=120

# Coverage filtering
COVERAGE_THRESHOLD=80
# Comma-separated patterns to exclude from coverage analysis (e.g. "types/,assets/,.d.ts")
COVERAGE_SKIP_PATTERNS=types/,assets/,.d.ts,main.tsx,vite-env,index.css,rootReducer.ts,store.ts
