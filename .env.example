OPENAI_API_KEY=your_api_key_here

# Model configuration
OPENAI_MODEL=gpt-5.4-mini
# Optional: use non-default OpenAI endpoint/org routing
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

# LLM behavior tuning
OPENAI_MAX_TOKENS_CLASSIFY=120
OPENAI_MAX_TOKENS_GENERATE=2600
OPENAI_MAX_TOKENS_REPAIR=3200
OPENAI_MAX_TOKENS_EXPLAIN=1500
OPENAI_TEMPERATURE_GENERATE=0.1
OPENAI_TEMPERATURE_REPAIR=0

# Agent runtime defaults
DEFAULT_COVERAGE_PATH=coverage/coverage-summary.json
DEFAULT_MAX_FILES=2
MAX_FIX_ATTEMPTS=3
TEST_TIMEOUT_SECONDS=120

# Coverage filtering
COVERAGE_THRESHOLD=80
# Comma-separated patterns to exclude from coverage analysis (e.g. "types/,assets/,.d.ts")
COVERAGE_SKIP_PATTERNS=types/,assets/,.d.ts,main.tsx,vite-env,index.css,rootReducer.ts,store.ts

# ──────────────────────────────────────────────────────────────────────────────
# C# backend test generation (run-csharp subcommand)
# Override token limits for C# generation independently of the JS defaults.
# ──────────────────────────────────────────────────────────────────────────────
# CSHARP_MAX_TOKENS_GENERATE=2600
# CSHARP_MAX_TOKENS_REPAIR=3200

# Optional: use separate Jira project/instance for C# backend runs.
# If unset, run-csharp falls back to shared JIRA_* variables.
# CSHARP_JIRA_URL=https://your-backend-workspace.atlassian.net
# CSHARP_JIRA_EMAIL=your-email@example.com
# CSHARP_JIRA_TOKEN=your_csharp_jira_api_token_here
# CSHARP_JIRA_PROJECT_KEY=YOUR_BACKEND_PROJECT_KEY
# CSHARP_JIRA_EPIC_KEY=

# Optional: use separate Bitbucket repo/workspace for C# backend runs.
# If unset, run-csharp falls back to shared BITBUCKET_* variables.
# CSHARP_BITBUCKET_WORKSPACE=your-backend-workspace
# CSHARP_BITBUCKET_REPO_SLUG=your-backend-repo-slug
# CSHARP_BITBUCKET_USERNAME=your-bitbucket-email@example.com
# CSHARP_BITBUCKET_TOKEN=your_backend_bitbucket_app_password_or_token_here
# CSHARP_BITBUCKET_DEFAULT_BRANCH=main
# CSHARP_BITBUCKET_REVIEWERS=

# ──────────────────────────────────────────────────────────────────────────────
# Jira integration (optional)
# Leave blank to disable Jira issue creation.
# ──────────────────────────────────────────────────────────────────────────────
JIRA_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
# Optional: link all auto-test issues to an existing epic (team-managed projects)
JIRA_EPIC_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Bitbucket integration (optional)
# Leave blank to disable PR creation.
# ──────────────────────────────────────────────────────────────────────────────
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=your-repo-slug
BITBUCKET_USERNAME=your-bitbucket-email@example.com
BITBUCKET_TOKEN=your_bitbucket_app_password_or_token_here
# Target branch for pull requests (default: main)
BITBUCKET_DEFAULT_BRANCH=main
# Optional: comma-separated Bitbucket account UUIDs to auto-assign as reviewers
BITBUCKET_REVIEWERS=
